{
    "version": "0.2.0-rc.2",
    "description": "Open-source agent harness developed by DeepSeek AI (desktop preview).",
    "homepage": "https://deepseek.com/harness",
    "license": "MIT",
    "notes": [
        "Built-in auto-update is disabled; updates are handled by Scoop.",
        "App data is persisted in the Scoop persist directory via a junction from '%APPDATA%\\@deepseek-ai\\dsh-desktop'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-0.2.0-rc.2-win-x64.exe#/dl.7z",
            "hash": "sha512:ada225c4c41df44497824b665625bb43054b723051e4922cacd3aef92a5e958f24b24752af61f9d7f7fe7b2d44a8523f78822b2900ae44034c79be52a6d45972"
        }
    },
    "pre_install": [
        "Get-Process 'DeepSeek Harness' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse"
    ],
    "installer": {
        "script": [
            "ensure \"$persist_dir\" | Out-Null",
            "$appDataPath = \"$env:APPDATA\\@deepseek-ai\\dsh-desktop\"",
            "if (Test-Path $appDataPath) {",
            "    $link = Get-Item $appDataPath -Force",
            "    if ($link.LinkType -eq 'Junction') {",
            "        $link.Delete()",
            "    } else {",
            "        Get-ChildItem $appDataPath -Force | Move-Item -Destination $persist_dir -Force",
            "        $link.Delete()",
            "    }",
            "}",
            "New-Item (Split-Path $appDataPath) -ItemType Directory -Force | Out-Null",
            "New-Item $appDataPath -ItemType Junction -Target $persist_dir | Out-Null"
        ]
    },
    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii"
    ],
    "pre_uninstall": "Get-Process 'DeepSeek Harness' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
    "uninstaller": {
        "script": [
            "$appDataPath = \"$env:APPDATA\\@deepseek-ai\\dsh-desktop\"",
            "$link = Get-Item $appDataPath -Force -ErrorAction SilentlyContinue",
            "if ($link -and $link.LinkType -eq 'Junction') { $link.Delete() }"
        ]
    },
    "bin": "resources\\runtime\\cli\\bin\\dsh.cmd",
    "shortcuts": [
        [
            "DeepSeek Harness.exe",
            "DeepSeek Harness"
        ]
    ],
    "checkver": {
        "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
        "regex": "version: ([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
            "regex": "(?s)sha512:.*?$base64"
        }
    }
}
