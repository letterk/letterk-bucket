{
    "version": "0.2.1-rc.5",
    "description": "Open-source agent harness developed by DeepSeek AI (desktop preview).",
    "homepage": "https://deepseek.com/harness",
    "license": "MIT",
    "notes": [
        "Built-in auto-update is disabled; updates are handled by Scoop.",
        "App data is persisted in the Scoop persist directory via junctions from '%APPDATA%\\@deepseek-ai\\dsh-desktop' and from '%USERPROFILE%\\.dsh' (the harness home holding credentials, sessions, profiles and runtimes)."
    ],
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-0.2.1-rc.5-win-x64.exe#/dl.7z",
            "hash": "sha512:82ed9d1fe693afaefc7343fc0c6007fe1e01d466967d0223a6c3eb2e397fba42eb40887a0cb56afcc857e0566f27ca3518232870e862c7a5db2dae8a9ad8d75e"
        }
    },
    "pre_install": [
        "Get-Process 'DeepSeek Harness' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse"
    ],
    "installer": {
        "script": [
            "ensure \"$persist_dir\" | Out-Null",
            "# Electron's userData directory and the harness home ($DSH_HOME, default ~/.dsh) both live in the persist directory.",
            "$links = @(",
            "    @{ Path = \"$env:APPDATA\\@deepseek-ai\\dsh-desktop\"; Target = \"$persist_dir\" }",
            "    @{ Path = \"$env:USERPROFILE\\.dsh\"; Target = \"$persist_dir\\home\" }",
            ")",
            "foreach ($link in $links) {",
            "    ensure $link.Target | Out-Null",
            "    if (Test-Path $link.Path) {",
            "        $item = Get-Item $link.Path -Force",
            "        if ($item.LinkType -eq 'Junction') {",
            "            # Already persisted: drop the link so it can be repointed.",
            "            $item.Delete()",
            "        } else {",
            "            # First run: move the real directory into the persist directory, keeping whatever is already persisted.",
            "            robocopy $link.Path $link.Target /E /MOVE /NFL /NDL /NJH /NJS /NP | Out-Null",
            "            if ($LASTEXITCODE -ge 8) { throw \"robocopy failed with exit code $LASTEXITCODE while moving $($link.Path).\" }",
            "        }",
            "    }",
            "    New-Item (Split-Path $link.Path) -ItemType Directory -Force | Out-Null",
            "    New-Item $link.Path -ItemType Junction -Target $link.Target | Out-Null",
            "}"
        ]
    },
    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii"
    ],
    "pre_uninstall": "Get-Process 'DeepSeek Harness' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
    "uninstaller": {
        "script": [
            "$links = @(\"$env:APPDATA\\@deepseek-ai\\dsh-desktop\", \"$env:USERPROFILE\\.dsh\")",
            "foreach ($path in $links) {",
            "    $link = Get-Item $path -Force -ErrorAction SilentlyContinue",
            "    if ($link -and $link.LinkType -eq 'Junction') { $link.Delete() }",
            "}"
        ]
    },
    "bin": "resources\\runtime\\cli\\bin\\dsh.cmd",
    "shortcuts": [
        [
            "DeepSeek Harness.exe",
            "DeepSeek Harness"
        ]
    ],
    "checkver": {
        "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
        "regex": "version: ([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
            "regex": "(?s)sha512:.*?$base64"
        }
    }
}
